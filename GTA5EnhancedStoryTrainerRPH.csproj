<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>GTA5EnhancedStoryTrainer.RPH</AssemblyName>
    <RootNamespace>GTA5EnhancedStoryTrainer</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>build\rph\</OutputPath>
    <DebugType>portable</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RagePluginHook" Version="1.124.0" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <Target Name="RemoveHostAssemblyFromPluginOutput" AfterTargets="Build">
    <Delete Files="$(OutputPath)RagePluginHook.dll" />
  </Target>
</Project>
